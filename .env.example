# Template for the backend's .env (copy to .env next to api_server.py and fill in). This template is committed;
# the real .env is git-ignored. Read once when the API starts; restart the API after editing.

# Ask ORCA: optional AI answers through Groq. Empty = AI answers off (the built-in answers still work).
GROQ_API_KEY=

# Optional overrides.
# ORCA_ASSISTANT_MODEL=llama-3.3-70b-versatile
# ORCA_ASSISTANT_LIMIT=20
# ORCA_ASSISTANT_WINDOW_S=600

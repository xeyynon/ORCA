# Copy to deploy/.env and edit.
# A DNS name pointing at the VM's public IP. Free, no signup: <ip-with-dashes>.sslip.io (e.g. 140-238-1-2.sslip.io).
ORCA_DOMAIN=140-238-1-2.sslip.io
# Comma-separated origins of a separately hosted frontend (e.g. Vercel). Empty = same-origin only.
ORCA_CORS_ORIGINS=https://orca-vitap.vercel.app
# Celestrak group fetched by "Refresh". "active" is ~10k objects; "stations" is a small, quick smoke test.
ORCA_TLE_GROUP=active
ORCA_FETCH_COOLDOWN_S=300
# "full" serves the frontend from this box too; "api" builds the backend only (frontend on Vercel).
ORCA_BUILD_TARGET=api

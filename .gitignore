# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Database — never commit live data
*.db
*.sqlite
*.sqlite3

# Generated HTML output files
output/
*.html

# Environment / secrets
.env
.env.*
*.env
# The template is committed; the real .env with keys never is.
!.env.example

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log
logs/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# MyPy
.mypy_cache/

# Distribution
*.whl
*.tar.gz

# Frontend (React + Vite)
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
# the blanket *.html rule above must not swallow the Vite entry page
!frontend/index.html

# Operator credential (hash + signing secret): never commit
auth.json

# Benchmark TLE snapshots are live data; their .json manifests are committed
benchmarks/data/*.tle
# Per-encounter TCA rows (~7 MB per run); regenerate with benchmarks/tca_estimation.py
benchmarks/results/tca_*/local.csv
# Per-object propagation errors (~5 MB per run); regenerate with benchmarks/propagation_accuracy.py
benchmarks/results/propagation_*/errors.csv

# Playwright MCP scratch output
.playwright-mcp/
